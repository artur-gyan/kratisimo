### =====================================================================
###  KRATISIMO - Working-hours validation tests (Chat 13, #1)
###
###  RUN: pata to prasino play dipla se kathe ### block, ME TH SEIRA.
###  To [0] login apothikevei to token automata gia ta epomena.
###  Kathe block exei automato assert (prasino = perase).
### =====================================================================

@host = http://localhost:8080


### [0] LOGIN - pairnei token, to apothikevei automata
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "kostas@example.com",
  "password": "customer123"
}

> {%
    client.test("Login OK (200)", function () {
        client.assert(response.status === 200, "Login apetyxe: " + response.status);
    });
    var t = response.body.token || response.body.accessToken;
    client.assert(t, "Den vrethike token. Des ti key epistrefei to AuthResponse.");
    client.global.set("auth_token", t);
%}


### [1] SERVICES - vriskei egkyra serviceIds (public), krataei to proto
# @name services
GET {{host}}/api/services

> {%
    client.test("Services OK (200)", function () {
        client.assert(response.status === 200, "GET /api/services: " + response.status);
    });
    client.assert(response.body.length > 0, "Kamia ypiresia - etrekse o DataSeeder; (profile=dev)");
    client.global.set("service_id", response.body[0].id);
    client.log("Xrisimopoio service_id = " + response.body[0].id);
%}


### [2] HAPPY PATH (specific employee) - entos orariou -> 201
### An pareis 409 = to slot piastike se proigoumeno run. Allakse tin ora (07:30, 08:00...).
### An pareis 400 = o employee 1 den doulevei ekeini tin ora - allakse ora/employee.
POST {{host}}/api/appointments
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "serviceIds": [{{service_id}}],
  "employeeId": 1,
  "startsAt": "2026-08-11T07:15:00Z"
}

> {%
    client.test("Happy path -> 201 (i 409 an piasmeno slot)", function () {
        var ok = response.status === 201 || response.status === 200;
        var slotTaken = response.status === 409;
        client.assert(ok || slotTaken,
            "Perimena 201 i 409, pira " + response.status +
            " - body: " + JSON.stringify(response.body));
        if (slotTaken) {
            client.log("409: to slot einai kleismeno (allakse ora gia katharo 201).");
        }
    });
%}


### [3] * KYRIA DOKIMI: EKTOS ORARIOU (Kyriaki) -> 400
### 2026-08-16 = Kyriaki. PRIN to fix pernouse (201). TORA kovetai.
POST {{host}}/api/appointments
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "serviceIds": [{{service_id}}],
  "employeeId": 1,
  "startsAt": "2026-08-16T09:00:00Z"
}

> {%
    client.test("Kyriaki -> 400 (to gap ekleise)", function () {
        client.assert(response.status === 400,
            "APOTYXIA FIX: perimena 400, pira " + response.status);
    });
    client.log("Minima: " + (response.body.message || JSON.stringify(response.body)));
%}


### [4] * D34 EDGE: ksexeilisma vardias (Nikos 09-13 + 17-21) -> 400
### 12:45 topika (kalokairi UTC+3) = 09:45 UTC. Ksekinaei sti vardia, ksexeilizei sto dialeimma.
### PROTA vres to employeeId tou Nikou sto pgAdmin:
###   SELECT ep.id, u.full_name FROM employee_profiles ep
###   JOIN users u ON u.id = ep.user_id WHERE u.full_name LIKE '%Nikos%';
### Allakse to employeeId parakato (tora ypotheto 4).
### An pareis 201: to service #1 einai poly synto - vale [1,2,3] gia megalyteri diarkeia.
POST {{host}}/api/appointments
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "serviceIds": [{{service_id}}],
  "employeeId": 4,
  "startsAt": "2026-08-11T09:45:00Z"
}

> {%
    client.test("Ksexeilisma vardias -> 400", function () {
        client.assert(response.status === 400,
            "Perimena 400, pira " + response.status);
    });
    client.log("Minima: " + (response.body.message || JSON.stringify(response.body)));
%}


### [5] MESANYXTA -> 400 (kaneis den doulevei 02:00)
### 23:00 UTC = 02:00 topika epomenis meras - ektos kathe vardias.
POST {{host}}/api/appointments
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "serviceIds": [{{service_id}}],
  "employeeId": 1,
  "startsAt": "2026-08-12T23:00:00Z"
}

> {%
    client.test("Mesanyxta -> 400", function () {
        client.assert(response.status === 400,
            "Perimena 400, pira " + response.status);
    });
%}


### =====================================================================
###  ANY-EMPLOYEE FLOW (employeeId = null) - apodeixi oti to false-negative efyge
### =====================================================================

### [6] ANY-FLOW entos orariou -> anathetei ergazomeno (201 i 409, OXI 400)
### employeeId LEIPEI = "opoiosdipote". To systima prepei na vrei ton least-loaded
### pou DOULEVEI kai einai eleftheros. DEN prepei na petaksei 400 lanthasmena.
### 08:15 UTC = 11:15 topika Tri - ora pou kapoioi doulevoun.
POST {{host}}/api/appointments
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "serviceIds": [{{service_id}}],
  "startsAt": "2026-08-11T08:15:00Z"
}

> {%
    client.test("Any-flow entos orariou -> 201 i 409 (OXI 400 working-hours)", function () {
        var ok = response.status === 201 || response.status === 200 || response.status === 409;
        client.assert(ok,
            "Perimena 201/409, pira " + response.status +
            " - body: " + JSON.stringify(response.body));
        var msg = response.body.message || "";
        client.assert(!(response.status === 400 && msg.indexOf("working hours") !== -1),
            "FALSE NEGATIVE: o least-loaded epelekse ektos-orariou ypallilo!");
    });
    client.log("Status: " + response.status + " | " + (response.body.message || JSON.stringify(response.body)));
%}


### [7] ANY-FLOW Kyriaki (kaneis den doulevei) -> 409 "no employee available"
### Any-flow: den ksexorizoume "repo" apo "piasmeno" - eniaio 409.
POST {{host}}/api/appointments
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "serviceIds": [{{service_id}}],
  "startsAt": "2026-08-16T09:00:00Z"
}

> {%
    client.test("Any-flow Kyriaki -> 409 (kaneis diathesimos)", function () {
        client.assert(response.status === 409,
            "Perimena 409 (kaneis den doulevei Kyriaki), pira " + response.status +
            " - body: " + JSON.stringify(response.body));
    });
    client.log("Minima: " + (response.body.message || JSON.stringify(response.body)));
%}
