### 2c.7 Η αλλαγή ισχύει ΑΜΕΣΩΣ, χωρίς restart (D150) + invariant του settle (D175)
GET http://localhost:8080/api/loyalty/me
Authorization: Bearer {{katerinaToken}}

> {%
    client.test("2c.7 Κατερίνα: enabled, N=5, πρόοδος < N", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        const b = response.body;
        client.assert(b.enabled === true, "enabled ≠ true (cache; restart;)");
        client.assert(b.visitsRequired === 5, "visitsRequired ≠ 5");
        client.assert(b.progress < 5, "Ενεργό αλλά πρόοδος ≥ N: το settle δεν έτρεξε");
        client.assert((b.availableRewards > 0) === (b.nextRewardPercent > 0),
            "availableRewards και nextRewardPercent ασυνεπή");
    });
%}


