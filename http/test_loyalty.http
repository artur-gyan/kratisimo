### 1c.1 Setup: υπηρεσία για τις κρατήσεις της ενότητας 3 + 5 μελλοντικές ώρες (μία ανά μέρα)
GET http://localhost:8080/api/services

> {%
    // IIFE: οι μεταβλητές μένουν τοπικές σε αυτό το script
    (function () {
        client.test("1c.1 GET /api/services → 200 + ενεργή υπηρεσία", function () {
            client.assert(response.status === 200, "Expected 200, got " + response.status);
            client.assert(response.body.some(function (x) { return x.active !== false; }),
                "Καμία ενεργή υπηρεσία");
        });
        const service = response.body.find(function (x) { return x.active !== false; });
        client.global.set("serviceId", String(service.id));
        client.global.set("servicePrice", String(service.price));

        const base = new Date();
        // Διαφορετική μέρα σε ΚΑΘΕ εκτέλεση: δευτερόλεπτα του ρολογιού mod 20000 (~55 χρόνια).
        // Όχι Math.random: στην 1η εκτέλεση έδωσε offset 0 → ίδιες ώρες σε κάθε run → 409.
        base.setUTCFullYear(base.getUTCFullYear() + 3);
        base.setUTCDate(base.getUTCDate() + Math.floor(Date.now() / 1000) % 20000);
        base.setUTCHours(10, 0, 0, 0);
        for (let i = 1; i <= 5; i++) {
            const d = new Date(base.getTime() + i * 24 * 3600 * 1000);
            client.global.set("slot" + i, d.toISOString());
        }
    })();
%}


### 2b.1 Πρόοδος Κατερίνας (όποια κι αν είναι η τρέχουσα κατάσταση)
GET http://localhost:8080/api/loyalty/me
Authorization: Bearer {{katerinaToken}}

> {%
    client.test("2b.1 GET /api/loyalty/me → 200 + συνεπή πεδία", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        const b = response.body;
        client.assert(b.hasOwnProperty("nextRewardPercent"), "Λείπει nextRewardPercent (D173)");
        client.assert(b.progress >= 0 && b.progress <= b.visitsRequired, "progress εκτός 0..N");
        if (!b.enabled) {
            client.assert(b.availableRewards === 0, "Ανενεργό αλλά availableRewards ≠ 0 (κανόνας 7)");
            client.assert(b.nextRewardPercent === 0, "Ανενεργό αλλά nextRewardPercent ≠ 0");
        }
    });
%}


