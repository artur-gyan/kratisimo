### 3.8 +1 σφραγίδα· αν η κάρτα γέμισε (1/2 → 2/2) → νέο δώρο, πρόοδος 0/2
GET http://localhost:8080/api/admin/customers/{{katerinaId}}/loyalty
Authorization: Bearer {{adminToken}}

> {%
    // IIFE: οι μεταβλητές μένουν τοπικές σε αυτό το script
    (function () {
        const b = response.body;
        const stamps = Number(client.global.get("L_stamps"));
        const progress = Number(client.global.get("L_progress"));
        const avail = Number(client.global.get("L_avail"));
        const used = avail > 0 ? 1 : 0;
        const earned = (progress + 1 >= 2) ? 1 : 0;
        client.test("3.8 Σφραγίδα + σωστή δημιουργία δώρου", function () {
            client.assert(b.completedVisits === stamps + 1, "completedVisits " + b.completedVisits + " ≠ " + (stamps + 1));
            client.assert(b.progress === (progress + 1) % 2, "progress " + b.progress + " ≠ " + ((progress + 1) % 2));
            client.assert(b.availableRewards === avail - used + earned,
                "availableRewards " + b.availableRewards + " ≠ " + (avail - used + earned));
        });
        client.global.set("M_stamps", String(b.completedVisits));
        client.global.set("M_progress", String(b.progress));
        client.global.set("M_avail", String(b.availableRewards));
        client.global.set("M_next", String(b.nextRewardPercent));
    })();
%}


