### 2e.2 Admin: λίστα πελατών με επιβράβευση (batch: σταθερό πλήθος queries)
GET http://localhost:8080/api/admin/customers/all
Authorization: Bearer {{adminToken}}

> {%
    client.test("2e.2 GET /api/admin/customers/all → loyalty σε κάθε πελάτη", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.length > 0, "Κενή λίστα πελατών");
        let katerina = null;
        for (let i = 0; i < response.body.length; i++) {
            const c = response.body[i];
            client.assert(c.loyalty !== null && c.loyalty !== undefined, "Χωρίς loyalty: " + c.email);
            client.assert(c.loyalty.progress >= 0 && c.loyalty.progress < c.loyalty.visitsRequired,
                "Πρόοδος εκτός 0..N-1 για " + c.email);
            if (c.email === "katerina@example.com") {
                katerina = c;
            }
        }
        client.assert(katerina !== null, "Η Κατερίνα δεν βρέθηκε στη λίστα");
        client.global.set("katerinaId", String(katerina.id));
    });
%}


