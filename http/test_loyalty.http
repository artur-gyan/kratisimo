### 3.1 Αφετηρία: κατάσταση Κατερίνας (όλα τα επόμενα ελέγχουν ΔΙΑΦΟΡΕΣ από εδώ)
GET http://localhost:8080/api/admin/customers/{{katerinaId}}/loyalty
Authorization: Bearer {{adminToken}}

> {%
    // IIFE: οι μεταβλητές μένουν τοπικές σε αυτό το script
    (function () {
        const b = response.body;
        client.test("3.1 Μετά το N=2: πρόοδος < 2 (όποιος έφτανε τον στόχο πήρε δώρο)", function () {
            client.assert(response.status === 200, "Expected 200, got " + response.status);
            client.assert(b.visitsRequired === 2, "visitsRequired ≠ 2");
            client.assert(b.progress < 2, "πρόοδος " + b.progress + " ≥ 2 → το settleAll δεν έτρεξε");
        });
        client.global.set("L_stamps", String(b.completedVisits));
        client.global.set("L_progress", String(b.progress));
        client.global.set("L_avail", String(b.availableRewards));
        client.global.set("L_next", String(b.nextRewardPercent));
    })();
%}


### 3.2 Κράτηση X (admin, για την Κατερίνα) → παίρνει το ΠΑΛΑΙΟΤΕΡΟ ελεύθερο δώρο, αν υπάρχει
POST http://localhost:8080/api/admin/appointments
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "serviceIds": [{{serviceId}}],
  "employeeId": {{employeeId}},
  "startsAt": "{{slot1}}",
  "customerId": {{katerinaId}},
  "guestName": null,
  "guestPhone": null
}

> {%
    // IIFE: οι μεταβλητές μένουν τοπικές σε αυτό το script
    (function () {
        const b = response.body;
        const avail = Number(client.global.get("L_avail"));
        const next = Number(client.global.get("L_next"));
        const price = Number(client.global.get("servicePrice"));
        client.test("3.2 Κράτηση X → 2xx, σωστό % δώρου, invariant τιμής", function () {
            client.assert(response.status >= 200 && response.status < 300, "Expected 2xx, got " + response.status);
            client.assert(b.discountPercent === (avail > 0 ? next : 0),
                "discountPercent " + b.discountPercent + " ≠ αναμενόμενο " + (avail > 0 ? next : 0));
            client.assert(Math.abs(Number(b.totalPrice) + Number(b.discountAmount) - price) < 0.001,
                "totalPrice + discountAmount ≠ τιμή καταλόγου");
        });
        client.global.set("apptX", String(b.id !== undefined ? b.id : b.appointmentId));
        client.test("id του νέου ραντεβού (apptX)", function () {
            client.assert(client.global.get("apptX") !== "undefined",
                "Το BookingResponse δεν έχει id/appointmentId. Πεδία: " + Object.keys(b).join(", "));
        });
    })();
%}


