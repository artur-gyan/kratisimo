### 3.19 Δώρα = πρόοδος / 2 (ακέραια), πρόοδος = πρόοδος % 2
GET http://localhost:8080/api/admin/customers/{{katerinaId}}/loyalty
Authorization: Bearer {{adminToken}}

> {%
    // IIFE: οι μεταβλητές μένουν τοπικές σε αυτό το script
    (function () {
        const b = response.body;
        const pp = Number(client.global.get("P_progress"));
        const pa = Number(client.global.get("P_avail"));
        client.test("3.19 D175: δώρα δημιουργήθηκαν στην αποθήκευση ρυθμίσεων", function () {
            client.assert(b.availableRewards === pa + Math.floor(pp / 2),
                "availableRewards " + b.availableRewards + " ≠ " + (pa + Math.floor(pp / 2)));
            client.assert(b.progress === pp % 2, "progress " + b.progress + " ≠ " + (pp % 2));
        });
    })();
%}


