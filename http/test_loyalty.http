### 3.26 Κανόνας 7: τα δώρα επανέρχονται· η ολοκλήρωση όσο ήταν ανενεργό ΔΕΝ μέτρησε
GET http://localhost:8080/api/admin/customers/{{katerinaId}}/loyalty
Authorization: Bearer {{adminToken}}

> {%
    // IIFE: οι μεταβλητές μένουν τοπικές σε αυτό το script
    (function () {
        const b = response.body;
        client.test("3.26 Ίδιες σφραγίδες, ίδια δώρα με πριν την απενεργοποίηση", function () {
            client.assert(b.enabled === true, "enabled ≠ true");
            client.assert(b.completedVisits === Number(client.global.get("W_stamps")),
                "δόθηκε σφραγίδα ενώ ήταν ανενεργό");
            client.assert(b.availableRewards === Number(client.global.get("W_avail")),
                "availableRewards " + b.availableRewards + " ≠ " + client.global.get("W_avail"));
        });
    })();
%}
